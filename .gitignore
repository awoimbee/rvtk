/target
**/*.rs.bk
.DS_Store
# Build directories produced by rvtk-gen (the committed output lives in the
# crate source trees, these are just scratch/build dirs).
/rvtk-sys/shim/build

# Local VTK scratch: source tree, build trees and prebuilt installs kept for
# offline/`RVTK_VTK_SOURCE_DIR`/`RVTK_VTK_PREBUILT_DIR` experiments.
/.deps/
# Output directory of the rendering test (it writes PNGs under rvtk/target).
/rvtk/target/

# VTK + shim build cache when RVTK_CACHE_DIR points inside the checkout, as the
# CI workflow does.
/.rvtk-cache/
